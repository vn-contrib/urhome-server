datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id          Int    @id @default(autoincrement())
  firebaseUid String @unique @map("firebase_uid") @db.VarChar(128)

  properties PropertyMember[]
  profile    Profile?

  @@map("users")
}

model Property {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  members PropertyMember[]
  leases  Lease[]

  @@map("properties")
}

model PropertyMember {
  propertyId Int                @map("property_id")
  userId     Int                @map("user_id")
  role       PropertyMemberRole @default(TENANT)

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([propertyId, userId])
  @@map("property_members")
}

enum PropertyMemberRole {
  OWNER   @map("owner")
  MANAGER @map("manager")
  TENANT  @map("tenant")

  @@map("property_member_role")
}

model Profile {
  id     Int    @id @default(autoincrement())
  userId Int?   @unique @map("user_id")
  name   String @db.VarChar(255)

  user User? @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Lease {
  id         Int       @id @default(autoincrement())
  propertyId Int       @map("property_id")
  startTime  DateTime  @map("start_time") @db.Timestamptz()
  endTime    DateTime? @map("end_time") @db.Timestamptz()

  property Property @relation(fields: [propertyId], references: [id])

  @@map("leases")
}

model Tenant {
  leaseId   Int @map("lease_id")
  profileId Int @map("profile_id")

  @@id([leaseId, profileId])
  @@map("tenants")
}
